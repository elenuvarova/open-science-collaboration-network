PORT=8000
NODE_ENV=development

# Leave blank locally → SQLite is used automatically (no install needed).
# In production set this to your Neon Postgres connection string (free, never
# expires). The GitHub Actions ETL uses the same var as a repo secret.
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# Free OpenAlex API key (openalex.org/settings/api) — used by the ETL only.
# OPENALEX_API_KEY=

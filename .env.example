PORT=8000
NODE_ENV=development

# Leave blank locally → SQLite is used automatically (no install needed).
# In production this is injected by Coolify and points at the container's own
# PostgreSQL (internal Docker network, no SSL). The in-process ETL uses the same var.
# DATABASE_URL=postgresql://postgres:pass@db-host:5432/postgres

# Free OpenAlex API key (openalex.org/settings/api) — used by the ETL only.
# OPENALEX_API_KEY=

# Groq API key for AI brief generation (free tier: console.groq.com).
# Without this, embeddings still run but the brief step is skipped.
# GROQ_API_KEY=
